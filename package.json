{
  "name": "transallendes-tms",
  "version": "1.0.0",
  "engines": {
    "node": "20.x"
  },
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx src/app.ts",
    "start": "node dist/app.js",
    "seed": "tsx src/seed/seed.ts",
    "simulate": "tsx src/scripts/simulate.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=html",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm install && npm run build",
    "docker:up": "docker compose up -d",
    "docker:seed": "docker compose exec backend npm run seed"
  },
  "dependencies": {
    "@sentry/node": "^10.56.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/sanitize-html": "^2.16.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "hi-base32": "^0.5.1",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.18.0",
    "sanitize-html": "^2.17.4",
    "stripe": "^22.1.1",
    "typescript": "^5.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "vitest": "^4.1.5"
  }
}
