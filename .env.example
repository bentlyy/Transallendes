# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transallendes
DB_POOL_MAX=25

# JWT (CRITICA - Generar valor real para produccion)
JWT_SECRET=CHANGEME_jwt_secret_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (CRITICA - Generar valor real para produccion)
ENCRYPTION_KEY=CHANGEME_encryption_key_16_chars

# HMAC Audit (CRITICA - Generar valor real para produccion)
AUDIT_HMAC_SECRET=CHANGEME_audit_hmac_secret_32_chars_long

# Multi-tenant
DEFAULT_TENANT_ID=transallendes

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (opcional)
EMAIL_PROVIDER=log
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@transallendes.com
EMAIL_FROM_NAME=Transallendes

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GPS Providers (opcional)
WIALON_API_KEY=
WIALON_API_URL=https://hst-api.wialon.com
TRACCAR_API_KEY=
TRACCAR_API_URL=http://localhost:8082
TELTONIKA_API_KEY=

# Rate Limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info

# Sentry (opcional)
SENTRY_DSN=

# Seed password (opcional, default: Admin123!)
# SEED_PASSWORD=your_custom_password
